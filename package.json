{
  "name": "pixi-spine-previewer",
  "productName": "Spine Previewer",
  "private": true,
  "version": "0.1.0",
  "description": "Spine 4.3 skeleton previewer built on PixiJS 8 — desktop (Tauri v2) and browser.",
  "author": "Yuhuan",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "package:mac": "tauri build",
    "package:win": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "package:all": "tauri build",
    "tauri": "tauri",
    "package:win:cross": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "version": "node scripts/sync-version.mjs && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.3.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "pixi.js": "8.18.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.0.14"
  }
}
